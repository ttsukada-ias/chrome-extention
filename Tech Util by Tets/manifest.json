{
  "manifest_version": 3,
  "name": "Tech Util by Tets",
  "version": "1",
  "description": "Standalone technical helper tools for JSON, XML, CSV, and URL encoding.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs"
  ],
  "action": {
    "default_title": "Tech Util by Tets",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
